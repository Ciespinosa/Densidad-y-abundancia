rmIdPM <- function(nI){
xy1$cod <- paste("p", 1:nrow(xy1))
codxy <- paste("p", 1:nrow(xy1))
recluxy <- list()
dtaxy <- list()
dtaxy[[1]] <- xy1
for(i in 1:nrow(xy1)){
if(i==1) xy <- dtaxy[[i]]
if(i>1) xy <- dtaxy[[i]]
pr <- codxy[i]
mxy <- xy[xy$xi>=(xy$xi[xy$cod==pr]-(size+size*0.5))&
xy$xi<=(xy$xi[xy$cod==pr]+(size+size*0.5))&
xy$yi>=(xy$yi[xy$cod==pr]-(size+size*0.5))&
xy$yi<=(xy$yi[xy$cod==pr]+(size+size*0.5)),]
if(nrow(mxy)>1){recluxy <- 0} else {recluxy <- 1}
if(recluxy==1){ dtaxy[[i+1]] <- xy} else{dtaxy[[i+1]] <- xy[xy$cod!=pr,]}
}
dtaxy[[i+1]]
return(xy)
}
