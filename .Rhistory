xi <- sample(seq(1,100, 0.1), nI, replace = T)
#set.seed(23)
yi <- sample(seq(1,100, 0.1), nI, replace = T)
xy1 <- data.frame(xi,yi)
xy1$cod <- paste("p", 1:nI)
codxy <- paste("p", 1:nI)
recluxy <- list()
dtaxy <- list()
dtaxy[[1]] <- xy1
for(i in 1:nrow(xy1)){
if(i==1) xy <- dtaxy[[i]]
if(i>1) xy <- dtaxy[[i]]
pr <- codxy[i]
mxy <- xy[xy$xi>=(xy$xi[xy$cod==pr]-(size+size*0.8))&
xy$xi<=(xy$xi[xy$cod==pr]+(size+size*0.8))&
xy$yi>=(xy$yi[xy$cod==pr]-(size+size*0.8))&
xy$yi<=(xy$yi[xy$cod==pr]+(size+size*0.8)),]
if(nrow(mxy)>1){recluxy <- 0} else {recluxy <- 1}
if(recluxy==1){ dtaxy[[i+1]] <- xy} else{dtaxy[[i+1]] <- xy[xy$cod!=pr,]}
}
if(nrow(xy) < nI*0.2){
